//FLOWJOB  JOB (ACCT),'STATUS FLOW',CLASS=A,MSGCLASS=X
//STEP1    EXEC PGM=FLOWSRC
//STEPLIB  DD DSN=TEST.LOADLIB,DISP=SHR
//POLIN    DD DSN=TEST.POLICY.MASTER,DISP=SHR
//STATOUT  DD DSN=TEST.STAT.OUT(+1),DISP=(NEW,CATLG,DELETE),
//            DCB=(RECFM=FB,LRECL=40,BLKSIZE=0)
//STEP2    EXEC PGM=SORT
//SORTIN   DD DSN=TEST.STAT.OUT(0),DISP=SHR
//SORTOUT  DD DSN=TEST.STAT.SORTED,DISP=(NEW,CATLG,DELETE)
//SYSIN    DD *
  SORT FIELDS=(1,12,CH,A)
/*
//STEP3    EXEC PGM=FLOWRDR
//STATIN   DD DSN=TEST.STAT.SORTED,DISP=SHR
//
