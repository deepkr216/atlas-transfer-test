* DFHCSDUP extract - member maintenance application
DEFINE TRANSACTION(MEMB) GROUP(MEMGRP)
       DESCRIPTION(MEMBER MAINTENANCE)
       PROGRAM(CONDLOGX) TWASIZE(0) PROFILE(DFHCICST)
       STATUS(ENABLED) TASKDATALOC(ANY)
DEFINE PROGRAM(CONDLOGX) GROUP(MEMGRP)
       LANGUAGE(COBOL) RELOAD(NO) STATUS(ENABLED)
DEFINE MAPSET(MEMSET) GROUP(MEMGRP) STATUS(ENABLED)
DEFINE FILE(POLMAST) GROUP(MEMGRP)
       DSNAME(PROD.POLICY.MASTER.KSDS) LSRPOOLID(1)
       ADD(YES) READ(YES) UPDATE(YES)
DEFINE TRANSACTION(MEMR) GROUP(MEMGRP) REMOTESYSTEM(CIC2)
