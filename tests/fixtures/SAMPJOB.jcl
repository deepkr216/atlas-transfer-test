//SAMPJOB  JOB (ACCT),'POLICY EXTRACT',CLASS=A,MSGCLASS=X
//*
//* NIGHTLY POLICY EXTRACT - FEEDS DOWNSTREAM DW
//*
//         SET HLQ=PROD.POLICY
//STEP010  EXEC PGM=SAMPPGM,PARM='RUNMODE=FULL'
//STEPLIB  DD DSN=&HLQ..LOADLIB,DISP=SHR
//POLMAST  DD DSN=&HLQ..MASTER.KSDS,DISP=SHR
//EXTRACT  DD DSN=&HLQ..EXTRACT(+1),DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,10),RLSE),
//            DCB=(RECFM=FB,LRECL=500,BLKSIZE=0)
//SYSIN    DD *
  RUNDATE=20260912
  REGION=ALL
  EXCLUDE-LAPSED=Y
/*
//STEP020  EXEC PGM=IKJEFT01,COND=(4,LT)
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(PREMCALC) PLAN(PREMCALC) LIB('PROD.POLICY.LOADLIB')
  END
/*
//SYSPRINT DD SYSOUT=*
//STEP030  EXEC PGM=DFSRRC00,PARM=(DLI,CLMPOST,CLMPOSTP)
//IMSACB   DD DSN=IMS.PROD.ACBLIB,DISP=SHR
//STEP040  EXEC PGM=SORT
//SORTIN   DD DSN=&HLQ..EXTRACT(0),DISP=SHR
//SORTOUT  DD DSN=&HLQ..EXTRACT.SORTED,DISP=(NEW,CATLG)
//SYSIN    DD *
  SORT FIELDS=(1,12,CH,A)
  INCLUDE COND=(25,2,CH,EQ,C'AC')
/*
//
