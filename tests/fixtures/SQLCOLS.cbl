000100 IDENTIFICATION DIVISION.
000200 PROGRAM-ID. SQLCOLS.
000300 DATA DIVISION.
000400 WORKING-STORAGE SECTION.
000500 01  WS-POL-NO               PIC X(12).
000600 01  WS-STATUS               PIC X(02).
000700 01  WS-PREM                 PIC S9(9)V99 COMP-3.
000800 01  WS-MEMBER-ID            PIC X(08).
000900 01  WS-GENDER-CD            PIC X.
001000 01  WS-ERR-MSG              PIC X(60).
001100     EXEC SQL DECLARE POLCUR CURSOR FOR
001200         SELECT P.POL_NO, P.STATUS_CD
001300           FROM POLICY_TBL P
001400          WHERE P.STATUS_CD = :WS-STATUS
001500     END-EXEC.
001600 PROCEDURE DIVISION.
001700 0000-MAIN.
001800     EXEC SQL
001900         SELECT PREM_AMT, STATUS_CD
002000           INTO :WS-PREM, :WS-STATUS
002100           FROM POLICY_TBL
002200          WHERE POL_NO = :WS-POL-NO
002300     END-EXEC.
002400     EXEC SQL OPEN POLCUR END-EXEC.
002500     EXEC SQL
002600         FETCH POLCUR INTO :WS-POL-NO, :WS-STATUS
002700     END-EXEC.
002800     EXEC SQL
002900         UPDATE MEMBER_TBL
003000            SET GENDER_CD = :WS-GENDER-CD
003100          WHERE MEMBER_ID = :WS-MEMBER-ID
003200     END-EXEC.
003300     EXEC SQL
003400         INSERT INTO AUDIT_TBL (MEMBER_ID, GENDER_CD)
003500              VALUES (:WS-MEMBER-ID, :WS-GENDER-CD)
003600     END-EXEC.
003700     STRING 'INVALID GENDER ' DELIMITED BY SIZE
003800            WS-GENDER-CD DELIMITED BY SPACE
003900            ' FOR MEMBER ' DELIMITED BY SIZE
004000            WS-MEMBER-ID DELIMITED BY SIZE
004100            INTO WS-ERR-MSG.
004200     DISPLAY 'AUDIT ' WS-MEMBER-ID ' STATUS ' WS-STATUS.
004300     GOBACK.
