//R09JOB   JOB  (ACCT),'GDG SAME JOB',CLASS=A,MSGCLASS=X
//STEP010  EXEC PGM=R09EXT
//EXTOUT   DD   DSN=PROD.R09.EXTRACT(+1),DISP=(NEW,CATLG,DELETE),
//          UNIT=SYSDA,SPACE=(CYL,(5,5))
//STEP020  EXEC PGM=SORT
//SORTIN   DD   DSN=PROD.R09.EXTRACT(+1),DISP=SHR
//SORTOUT  DD   DSN=PROD.R09.EXTRACT.SORTED,DISP=(NEW,CATLG,DELETE),
//          UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSIN    DD   *
  SORT FIELDS=(1,12,CH,A)
