{
  "_comment": "Where the automation looks. One row per mainframe dataset; `system` is the department, and each department gets its own folder under local_root (CLAIMS/PROD.CLAIMS.SRC). The ORDER of a department's copybook rows is the SYSLIB order its programs compile against - first match wins when a copybook name exists in several. Fetch SOURCE libraries only: PSBLIB / DBDLIB / ACBLIB / LOADLIB are compiled output. In the UI: Bulk add pastes a department's dataset list and infers kinds; the System filter, Fetch system and Move up/down work per department. CLI: python -m atlas.fetch --config sources.json --check / --plan / --all --build",
  "zowe": {
    "executable": "zowe",
    "profile": "",
    "encoding": "",
    "max_concurrent": 8,
    "timeout_seconds": 3600,
    "extra_args": []
  },
  "local_root": "C:/estate",
  "db": "atlas.db",
  "sources": [
    { "dataset": "PROD.CLAIMS.SRC",       "type": "pds", "kind": "cobol",    "system": "CLAIMS", "local": "CLAIMS/PROD.CLAIMS.SRC",       "ext": "cbl",    "authoritative": true,  "enabled": true, "extra_args": [] },
    { "dataset": "PROD.CLAIMS.COPYLIB",   "type": "pds", "kind": "copybook", "system": "CLAIMS", "local": "CLAIMS/PROD.CLAIMS.COPYLIB",   "ext": "cpy",    "authoritative": true,  "enabled": true, "extra_args": [] },
    { "dataset": "PROD.COMMON.COPYLIB",   "type": "pds", "kind": "copybook", "system": "CLAIMS", "local": "CLAIMS/PROD.COMMON.COPYLIB",   "ext": "cpy",    "authoritative": true,  "enabled": true, "extra_args": [] },
    { "dataset": "PROD.CLAIMS.JCLLIB",    "type": "pds", "kind": "jcl",      "system": "CLAIMS", "local": "CLAIMS/PROD.CLAIMS.JCLLIB",    "ext": "jcl",    "authoritative": true,  "enabled": true, "extra_args": [] },
    { "dataset": "PROD.CLAIMS.PROCLIB",   "type": "pds", "kind": "proc",     "system": "CLAIMS", "local": "CLAIMS/PROD.CLAIMS.PROCLIB",   "ext": "prc",    "authoritative": true,  "enabled": true, "extra_args": [] },
    { "dataset": "PROD.CLAIMS.PARMLIB",   "type": "pds", "kind": "ctlcard",  "system": "CLAIMS", "local": "CLAIMS/PROD.CLAIMS.PARMLIB",   "ext": "ctl",    "authoritative": true,  "enabled": true, "extra_args": [] },
    { "dataset": "PROD.CLAIMS.PSBSOURCE", "type": "pds", "kind": "psb",      "system": "CLAIMS", "local": "CLAIMS/PROD.CLAIMS.PSBSOURCE", "ext": "psb",    "authoritative": true,  "enabled": true, "extra_args": [] },
    { "dataset": "PROD.CLAIMS.DBDSOURCE", "type": "pds", "kind": "dbd",      "system": "CLAIMS", "local": "CLAIMS/PROD.CLAIMS.DBDSOURCE", "ext": "dbd",    "authoritative": true,  "enabled": true, "extra_args": [] },
    { "dataset": "PROD.CLAIMS.MFSSRC",    "type": "pds", "kind": "mfs",      "system": "CLAIMS", "local": "CLAIMS/PROD.CLAIMS.MFSSRC",    "ext": "mfs",    "authoritative": true,  "enabled": true, "extra_args": [] },
    { "dataset": "PROD.CLAIMS.PSBLIB",    "type": "pds", "kind": "psb",      "system": "CLAIMS", "local": "CLAIMS/PROD.CLAIMS.PSBLIB",    "ext": "psb",    "authoritative": false, "enabled": false, "extra_args": [], "_note": "compiled PSBs - kept disabled on purpose" },
    { "dataset": "PROD.POLICY.SRC",       "type": "pds", "kind": "cobol",    "system": "POLICY", "local": "POLICY/PROD.POLICY.SRC",       "ext": "cbl",    "authoritative": true,  "enabled": true, "extra_args": [] },
    { "dataset": "PROD.POLICY.COPYLIB",   "type": "pds", "kind": "copybook", "system": "POLICY", "local": "POLICY/PROD.POLICY.COPYLIB",   "ext": "cpy",    "authoritative": true,  "enabled": true, "extra_args": [] },
    { "dataset": "PROD.POLICY.JCLLIB",    "type": "pds", "kind": "jcl",      "system": "POLICY", "local": "POLICY/PROD.POLICY.JCLLIB",    "ext": "jcl",    "authoritative": true,  "enabled": true, "extra_args": [] },
    { "dataset": "PROD.POLICY.PROCLIB",   "type": "pds", "kind": "proc",     "system": "POLICY", "local": "POLICY/PROD.POLICY.PROCLIB",   "ext": "prc",    "authoritative": true,  "enabled": true, "extra_args": [] },
    { "dataset": "PROD.CICS.BMSSRC",      "type": "pds", "kind": "bms",      "system": "POLICY", "local": "POLICY/PROD.CICS.BMSSRC",      "ext": "bms",    "authoritative": true,  "enabled": true, "extra_args": [] },
    { "dataset": "PROD.IMS.STAGE1",       "type": "pds", "kind": "imsgen",   "system": "SHARED", "local": "SHARED/PROD.IMS.STAGE1",       "ext": "imsgen", "authoritative": true,  "enabled": true, "extra_args": [] },
    { "dataset": "PROD.CICS.CSD.EXTRACT", "type": "seq", "kind": "csd",      "system": "SHARED", "local": "SHARED/cics-csd.txt",          "ext": "csd",    "authoritative": true,  "enabled": true, "extra_args": [] },
    { "dataset": "PROD.CA7.JOBDEP.CSV",   "type": "seq", "kind": "sched",    "system": "SHARED", "local": "SHARED/ca7-deps.csv",          "ext": "csv",    "authoritative": false, "enabled": true, "extra_args": [] }
  ]
}
